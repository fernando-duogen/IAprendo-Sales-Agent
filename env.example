# ============================================================================
# IAprendo Sales Agent - Configuração de Ambiente
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores (NUNCA commite o arquivo .env)
# 3. Ou execute o wizard: python setup_config.py
# ============================================================================

# ----------------------------------------------------------------------------
# NEGÓCIO (Obrigatório)
# ----------------------------------------------------------------------------
COMPANY_NAME="IAprendo"
YOUR_NAME="Seu Nome Completo"
YOUR_EMAIL="seu.email@iaprendo.com.br"
YOUR_PHONE="+55 51 99999-9999"
WEBSITE="https://iaprendo.com.br"

# ----------------------------------------------------------------------------
# CSV - Mapeamento de Colunas (Customizável)
# ----------------------------------------------------------------------------
# Caminho do arquivo CSV oficial do MEC (~210k escolas)
CSV_PATH="data/raw/escolas_brasil.csv"
CSV_ENCODING="utf-8"

# Nome das colunas no CSV (ajuste conforme seu arquivo)
CSV_COL_NAME="Escola"
CSV_COL_INEP="Código INEP"
CSV_COL_CITY="Município"
CSV_COL_STATE="UF"
CSV_COL_ADDRESS="Endereço"
CSV_COL_PHONE="Telefone"
CSV_COL_RESTRICTION="Restrição de Atendimento"
CSV_COL_LEVELS="Etapas e Modalidade de Ensino Oferecidas"
CSV_COL_ADMIN_CATEGORY="Categoria Administrativa"
CSV_COL_ADMIN_DEPENDENCY="Dependência Administrativa"
CSV_COL_LATITUDE="Latitude"
CSV_COL_LONGITUDE="Longitude"
CSV_COL_SIZE="Porte da Escola"

# ----------------------------------------------------------------------------
# ICP - Perfil de Cliente Ideal (Filtros de Qualificação)
# ----------------------------------------------------------------------------
# Localização alvo
TARGET_CITY="Porto Alegre"
TARGET_STATE="RS"

# Tipos de escola (separados por vírgula)
# Opções: publica, privada, municipal, estadual, federal
TARGET_SCHOOL_TYPES="publica,privada"

# Níveis de ensino (separados por vírgula)
# Opções: fundamental, medio
TARGET_EDUCATION_LEVELS="fundamental,medio"

# Metas de prospecção
TARGET_LEADS_PER_WEEK=10
MAX_DAILY_EMAILS=20

# ----------------------------------------------------------------------------
# FEATURES OPCIONAIS (true/false)
# ----------------------------------------------------------------------------
ENABLE_GEOCODING=true              # Buscar coordenadas via Google Maps
ENABLE_PHONE_SEARCH=true           # Buscar telefones via Google Search
ENABLE_MAP_VIEW=true               # Visualização de mapa no dashboard

# ----------------------------------------------------------------------------
# ANTHROPIC (Obrigatório)
# ----------------------------------------------------------------------------
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Modelos Claude (NÃO alterar sem necessidade)
CLAUDE_MODEL_FAST="claude-haiku-4-5-20251001"        # Qualificação (rápido)
CLAUDE_MODEL_QUALITY="claude-sonnet-4-5-20250929"    # Escrita (qualidade)

# ----------------------------------------------------------------------------
# SUPABASE (Obrigatório)
# ----------------------------------------------------------------------------
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ----------------------------------------------------------------------------
# HUBSPOT (Opcional mas Recomendado)
# ----------------------------------------------------------------------------
# Obtenha em: https://app.hubspot.com/settings/integrations/api-key
HUBSPOT_API_KEY=""
HUBSPOT_PORTAL_ID=""

# ----------------------------------------------------------------------------
# EMAIL (Escolha 1 Provedor)
# ----------------------------------------------------------------------------
# Opções: brevo, gmail, none
EMAIL_PROVIDER="brevo"

# BREVO (300 emails/dia grátis)
# Obtenha em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""

# GMAIL (500 emails/dia)
# Siga: https://developers.google.com/gmail/api/quickstart/python
GMAIL_CREDENTIALS_PATH="credentials.json"

# ----------------------------------------------------------------------------
# GOOGLE MAPS (Opcional - Geocodificação)
# ----------------------------------------------------------------------------
# Obtenha em: https://console.cloud.google.com/google/maps-apis/credentials
# $200 créditos grátis/mês (suficiente para ~40k geocodificações)
GOOGLE_MAPS_API_KEY=""

# ----------------------------------------------------------------------------
# ENRIQUECIMENTO DE DADOS (Todos Opcionais)
# ----------------------------------------------------------------------------
# Apollo.io (60 créditos/mês grátis)
# https://app.apollo.io/settings/integrations/api
APOLLO_API_KEY=""
APOLLO_MONTHLY_LIMIT=60

# Snov.io (50 créditos/mês grátis)
# https://app.snov.io/api-setting
SNOV_API_KEY=""
SNOV_MONTHLY_LIMIT=50

# Hunter.io (25 buscas/mês grátis)
# https://hunter.io/api_keys
HUNTER_API_KEY=""
HUNTER_MONTHLY_LIMIT=25

# ----------------------------------------------------------------------------
# WHATSAPP (Futuro)
# ----------------------------------------------------------------------------
# Opções: manual, twilio, evolution
WHATSAPP_PROVIDER="manual"

# ----------------------------------------------------------------------------
# SISTEMA (Configurações Técnicas)
# ----------------------------------------------------------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Ambiente: development, production
ENVIRONMENT="development"

# Porta do dashboard Streamlit
DASHBOARD_PORT=8501

# ============================================================================
# VALIDAÇÃO
# ============================================================================
# Após preencher, teste com:
#   python -c "from config.settings import settings; settings.validate_required()"
#
# CAMPOS OBRIGATÓRIOS MÍNIMOS:
#   - ANTHROPIC_API_KEY
#   - SUPABASE_URL
#   - SUPABASE_KEY
#   - YOUR_EMAIL
#   - CSV_PATH
# ============================================================================
