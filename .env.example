# --- Email (Brevo) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=seu@email.com
BREVO_SENDER_NAME=Seu Nome
# Copia oculta no envio de producao (um endereco ou varios separados por virgula).
# Serve pra voce receber o e-mail exatamente como o cliente recebeu.
# Vazio = sem copia. Atencao: cada BCC consome 1 credito Brevo separado.
